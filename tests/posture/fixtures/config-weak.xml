      <ipaddrv6>2001:db8::1</ipaddrv6><subnetv6>64</subnetv6></lan>
  </interfaces>
  <syslog><nologdefaultblock>1</nologdefaultblock></syslog>
  <OPNsense>
    <Firewall><Filter>
      <rules>
        <rule uuid="11111111-1111-4111-8111-111111111111"><enabled>1</enabled><action>pass</action><interface>lan</interface>
          <direction>in</direction><ipprotocol>inet</ipprotocol><source_net>any</source_net><destination_net>any</destination_net>
          <log>0</log><description>allow everything</description></rule>
        <rule uuid="22222222-2222-4222-8222-222222222222"><enabled>1</enabled><action>block</action><interface>lan</interface>
          <direction>in</direction><ipprotocol>inet</ipprotocol><source_net>any</source_net><destination_net>any</destination_net>
          <log>0</log><description>silent block</description></rule>
        <rule uuid="33333333-3333-4333-8333-333333333333"><enabled>1</enabled><action>pass</action><interface>wan</interface>
