<?xml version="1.0"?>
<!-- fictional configuration with many weak settings; documentation addresses only -->
<opnsense>
  <system>
    <hostname>fw-test</hostname>
    <domain>example.test</domain>
    <group><name>admins</name><gid>1999</gid><member>0,2000,2001</member><priv>page-all</priv></group>
    <user><name>root</name><uid>0</uid><scope>system</scope><password>$2y$10$fake</password><disabled>0</disabled></user>
    <user><name>alice</name><uid>2000</uid><password>$2y$10$fake</password><apikeys><item><key>k</key></item></apikeys></user>
    <user><name>bob</name><uid>2001</uid><password>$2y$10$fake</password><shell>/bin/sh</shell>
      <authorizedkeys>c3NoLWRzcyBBQUFBQjNOemFDMWtjM01BQUFDQkFQIGJvYkBleGFtcGxlCg==</authorizedkeys></user>
