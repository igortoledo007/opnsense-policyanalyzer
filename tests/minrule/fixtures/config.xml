<?xml version="1.0"?>
<!-- fictional configuration for the minimal rule tests; documentation addresses only -->
<opnsense>
  <system><hostname>fw</hostname><webgui><protocol>https</protocol></webgui></system>
  <interfaces>
    <wan><enable>1</enable><if>vtnet0</if><descr>WAN</descr><ipaddr>198.51.100.2</ipaddr><subnet>24</subnet>
      <gateway>WAN_GW</gateway></wan>
    <lan><enable>1</enable><if>vtnet1</if><descr>LAN</descr><ipaddr>192.0.2.1</ipaddr><subnet>25</subnet></lan>
    <opt1><enable>1</enable><if>vtnet2</if><descr>SERVERS</descr><ipaddr>192.0.2.129</ipaddr><subnet>26</subnet></opt1>
  </interfaces>
  <OPNsense><Firewall>
    <Alias version="1.0.1"><geoip><url/></geoip><aliases/></Alias>
    <Filter version="1.0.6"><rules>
      <rule uuid="00000000-0000-4000-8000-0000000000b0"><enabled>1</enabled><action>block</action><quick>1</quick>
        <interface>lan</interface><direction>in</direction><ipprotocol>inet</ipprotocol><protocol>any</protocol>
        <source_net>any</source_net><destination_net>203.0.113.66</destination_net><sequence>5</sequence>
        <description>block bad host</description></rule>
      <rule uuid="00000000-0000-4000-8000-0000000000a1"><enabled>1</enabled><action>pass</action><quick>1</quick>
        <interface>lan</interface><direction>in</direction><ipprotocol>inet</ipprotocol><protocol>any</protocol>
        <source_net>lan</source_net><destination_net>any</destination_net><log>1</log><sequence>10</sequence>
        <description>LAN to any (logged)</description></rule>
      <rule uuid="00000000-0000-4000-8000-0000000000a2"><enabled>1</enabled><action>pass</action><quick>1</quick>
        <interface>opt1</interface><direction>in</direction><ipprotocol>inet</ipprotocol><protocol>any</protocol>
        <source_net>any</source_net><destination_net>any</destination_net><log>0</log><sequence>20</sequence>
        <description>servers to any (no log)</description></rule>
      <rule uuid="00000000-0000-4000-8000-0000000000a3"><enabled>1</enabled><action>pass</action><quick>1</quick>
        <interface>wan</interface><direction>in</direction><ipprotocol>inet</ipprotocol><protocol>udp</protocol>
        <source_net>any</source_net><destination_net>wanip</destination_net><destination_port>51820</destination_port>
        <log>1</log><sequence>30</sequence><description>WireGuard listener</description></rule>
      <rule uuid="00000000-0000-4000-8000-0000000000a4"><enabled>1</enabled><action>block</action><quick>1</quick>
        <interface>lan</interface><direction>in</direction><ipprotocol>inet</ipprotocol><protocol>any</protocol>
        <source_net>any</source_net><destination_net>any</destination_net><log>1</log><sequence>40</sequence>
        <description>block rest</description></rule>
      <rule uuid="00000000-0000-4000-8000-0000000000a5"><enabled>1</enabled><action>pass</action><quick>1</quick>
        <interface>lan</interface><direction>in</direction><ipprotocol>inet</ipprotocol><protocol>tcp</protocol>
        <source_net>lan</source_net><destination_net>192.0.2.130</destination_net><destination_port>22</destination_port>
        <log>1</log><sequence>50</sequence><description>ssh to server</description></rule>
    </rules></Filter>
  </Firewall></OPNsense>
</opnsense>
