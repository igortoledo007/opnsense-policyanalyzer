            benchmark: "{{ lang._('Benchmark') }}",
            benchModel: "{{ lang._('Model to measure') }}",
            benchHelp: "{{ lang._('Fixed prompt, 128 generated tokens, the configured threads. Nothing is changed; the report is kept for this page.') }}",
