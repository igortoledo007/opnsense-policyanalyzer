            branchHelp: "{{ lang._('Which FreeBSD package repository the jail installs misc/ollama from.') }}",
            cpuset: "{{ lang._('CPUs for the jail (cpuset)') }}",
            cpusetHelp: "{{ lang._('CPU numbers or ranges, e.g. 2-3 or 1,3; this system has %n threads. Leave at least half of them to the firewall.') }}",
            cpusetInvalid: "{{ lang._('Use CPU numbers or ranges such as 2-3 or 1,3.') }}",
            cpusetLater: "{{ lang._('At most three options can be passed at once: the runtime is installed with the default cpuset and your value is applied in the Limits step.') }}",
            startNow: "{{ lang._('Start the runtime after installing') }}",
            startAtBoot: "{{ lang._('Start the runtime at boot') }}",
            installWhat: "{{ lang._('Simulate shows the download size (FreeBSD base and packages), the disk space, every command, the ports and how to undo it. Apply runs in the background with progress and Cancel.') }}",
            installRuntime: "{{ lang._('Install runtime') }}",
            runtimeControls: "{{ lang._('Service') }}",
            startRuntime: "{{ lang._('Start') }}",
            stopRuntime: "{{ lang._('Stop') }}",
            enableBoot: "{{ lang._('Enable at boot') }}",
            disableBoot: "{{ lang._('Disable at boot') }}",
            /* step 5: model */
            modelHelp: "{{ lang._('Pick the model the explanations will use. The recommendation is computed from this hardware; the download is verified (SHA256) and can be cancelled.') }}",
            chosenModel: "{{ lang._('Chosen model') }}",
            chosen: "{{ lang._('chosen') }}",
            modelNoRuntime: "{{ lang._('The runtime is not installed yet: a model can be downloaded now and becomes usable once it is.') }}",
            loadedInRam: "{{ lang._('loaded in RAM') }}",
            useModel: "{{ lang._('Use') }}",
            removeModel: "{{ lang._('Remove') }}",
            noModelsYet: "{{ lang._('No model downloaded yet.') }}",
            importTitle: "{{ lang._('Import a GGUF model') }}",
            importHelp: "{{ lang._('Copy the .gguf file to /var/db/ai/models/import/ with scp (or give hf:owner/repo/file.gguf to download it from Hugging Face), then simulate the import. Ollama keeps its own copy of the weights.') }}",
            importSource: "{{ lang._('File in the import directory or hf:owner/repo/file.gguf') }}",
            importName: "{{ lang._('Model name (name:tag)') }}",
            importSha: "{{ lang._('SHA-256 (required for a local file)') }}",
            importTemplate: "{{ lang._('Chat template') }}",
            importTplGguf: "{{ lang._('embedded in the file') }}",
            importCleanup: "{{ lang._('Delete the source file after the import (irreversible)') }}",
