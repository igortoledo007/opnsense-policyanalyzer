{#
 # AI setup assistant: strings of PASetup (js/policyanalyzer/setup.js), included by index.volt.
 # The assistant is a modal over the Policy Analyzer page: the "AI setup" button of the Findings tab, the
 # "Open AI setup" link of the Settings tab, /ui/policyanalyzer/#setup[-N] and the route /ui/policyanalyzer/setup
 # (SetupController, renders index.volt with openSetup) open it. Steps and probes: see WIZARD.md and setup.js.
 #}
<script>
    'use strict';

    $(document).ready(function () {
        PASetup.setStrings({
            title: "{{ lang._('AI setup') }}",
            intro: "{{ lang._('Prepares the optional AI explanations step by step. Every step shows the state detected now; Simulate shows exactly what would change, Apply asks for confirmation, and every change can be reverted from the action history. Nothing is ever applied without its simulation.') }}",
            stepsLabel: "{{ lang._('Steps') }}",
            helpTitle: "{{ lang._('What does the AI setup do?') }}",
            racctPendingShort: "{{ lang._('enabled, pending reboot') }}",
            simulateDownload: "{{ lang._('Simulate download') }}",
            simulatePrepare: "{{ lang._('Simulate prepare') }}",
            reasonModelFirst: "{{ lang._('Download the chosen model first (Simulate download, then Download).') }}",
            reasonStorageFirst: "{{ lang._('Prepare the storage first (Simulate prepare, then Prepare storage).') }}",
            condRunning: "{{ lang._('A setup job is running for this step; its progress is shown above and in the action history.') }}",
            condPartial: "{{ lang._('The installation of the local AI did not finish: part of it is on disk.') }}",
            condFailed: "{{ lang._('The last installation of the local AI failed and was rolled back.') }}",
            condStopped: "{{ lang._('The local AI is installed but not running.') }}",
            condPull: "{{ lang._('The download of %s did not finish.') }}",
            resumeInstall: "{{ lang._('Resume installation') }}",
            cleanupPartial: "{{ lang._('Clean up partial install') }}",
            resumeDownload: "{{ lang._('Resume download') }}",
            simulateInstall: "{{ lang._('Simulate install') }}",
            applyInstall: "{{ lang._('Apply install') }}",
            reasonInstallFirst: "{{ lang._('Install the runtime first (Simulate install, then Apply install).') }}",
            removeLocalAi: "{{ lang._('Remove local AI') }}",
            removeLocalAiHelp: "{{ lang._('Remove local AI undoes the installation with one click; downloaded models are kept unless you choose to delete them.') }}",
            deleteModels: "{{ lang._('Also delete downloaded models (%s)') }}",
            plainRevertInstall: "{{ lang._('You can undo this at any time with one click: the local AI is removed and the firewall goes back to how it was. Downloaded models are kept unless you choose to delete them.') }}",
            plainRevertRemove: "{{ lang._('The local AI is removed and the firewall goes back to how it was before the installation. This removal is recorded too and can be undone from the action history (it installs the local AI again).') }}",
            plainRevertUninstall: "{{ lang._('This removal is recorded and can be undone from the action history with one click (the local AI is installed again; deleted models are not restored).') }}",
            plainRevertService: "{{ lang._('You can undo this with one click from the action history.') }}",
            plainRevertModel: "{{ lang._('You can undo this with one click: the model is deleted again.') }}",
            plainRevertStorage: "{{ lang._('You can undo this with one click while the storage is empty: the folders (and the dataset) created here are removed.') }}",
            plainRevertLimits: "{{ lang._('You can undo this with one click: the previous limits come back.') }}",
            plainRevertRacct: "{{ lang._('You can undo this with one click: the tunable goes back to its previous value (effective after the next reboot).') }}",
            plainRevertRevert: "{{ lang._('This undo is recorded too and can itself be undone from the action history.') }}",
            racctOff: "{{ lang._('The RAM limit of the local AI is off (kern.racct.enable=0).') }}",
            racctManual: "{{ lang._('This version of the setup component can not change it yet.') }}",
            racctPending: "{{ lang._('RAM limit enabled: it becomes active after the next reboot of the firewall.') }}",
            rebootLink: "{{ lang._('System: Power: Reboot') }}",
            enableRamLimit: "{{ lang._('Enable RAM limit') }}",
            memLabel: "{{ lang._('RAM limit (GB)') }}",
            memHelp: "{{ lang._('Maximum memory of the jail (RCTL).') }}",
