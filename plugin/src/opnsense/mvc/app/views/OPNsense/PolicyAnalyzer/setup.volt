            step_finish: "{{ lang._('Finish') }}",
            jobRunning: "{{ lang._('A setup job is running') }}",
            probeFailed: "{{ lang._('The state could not be read (see the system log).') }}",
            readOnlyStep: "{{ lang._('This step only reads the system; nothing is changed.') }}",
            none: "{{ lang._('none') }}",
            unknown: "{{ lang._('unknown') }}",
            enabled: "{{ lang._('enabled') }}",
            disabled: "{{ lang._('disabled') }}",
            running: "{{ lang._('running') }}",
            notRunning: "{{ lang._('not running') }}",
            threads: "{{ lang._('threads') }}",
            cores: "{{ lang._('cores') }}",
            total: "{{ lang._('total') }}",
            available: "{{ lang._('available') }}",
            /* undo (filtered action history) */
            undoHelp: "{{ lang._('Changes made by this step, newest first. Revert first shows a simulation of what will be undone.') }}",
            undoEmpty: "{{ lang._('This step has not changed anything yet.') }}",
            reverted: "{{ lang._('reverted') }}",
            revert: "{{ lang._('Revert') }}",
            undoFull: "{{ lang._('Open the full action history') }}",
            /* step 1: check */
            chkProduct: "{{ lang._('System') }}",
            chkCpu: "{{ lang._('CPU') }}",
            chkFlags: "{{ lang._('Instruction sets') }}",
            chkRam: "{{ lang._('RAM') }}",
            chkDisk: "{{ lang._('Disk') }}",
            freeFor: "{{ lang._('free for') }}",
            chkLoadAvg: "{{ lang._('Load average (1 / 5 / 15 min)') }}",
            chkServices: "{{ lang._('Heavy services') }}",
            chkRacct: "{{ lang._('Resource accounting (kern.racct.enable)') }}",
            chkArch: "{{ lang._('The FreeBSD Ollama package only exists for amd64') }}",
            chkRelease: "{{ lang._('The local runtime targets FreeBSD 15') }}",
            chkRamTooSmall: "{{ lang._('Less than 8 GB of RAM: a local model would starve the firewall') }}",
            chkRamSmall: "{{ lang._('Less than 12 GB of RAM: only small models (up to 3B) fit') }}",
            chkDiskTooSmall: "{{ lang._('Less than 4 GiB free: no room for the runtime and a model') }}",
