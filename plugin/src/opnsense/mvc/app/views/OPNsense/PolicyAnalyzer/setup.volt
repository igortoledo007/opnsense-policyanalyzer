            chkIps: "{{ lang._('Suricata in IPS mode: inference competes with inline inspection') }}",
            chkHeavy: "{{ lang._('Service competing for CPU and memory') }}",
            chkIgpu: "{{ lang._('Integrated GPU not used: it shares the memory channel and OPNsense ships no driver for it.') }}",
            verdict_fit: "{{ lang._('Fit for a local runtime') }}",
            verdict_reservations: "{{ lang._('Fit with reservations') }}",
            verdict_no: "{{ lang._('Not recommended for a local runtime') }}",
            verdictFitHelp: "{{ lang._('The following steps install an isolated Ollama runtime on this firewall. You can still choose a server in your LAN or an API instead.') }}",
            verdictResHelp: "{{ lang._('A local runtime works, but expect slower answers and plan explanations outside peak hours. A server in your LAN or an API is the comfortable option.') }}",
            verdictNoHelp: "{{ lang._('Choose a model server in your LAN or an API in the next step; the local runtime steps are skipped.') }}",
            /* step 2: provider */
            providerHelp: "{{ lang._('Where should the explanations come from? Ollama keeps the data in your network; Claude Code (LAN) sends it to a computer in your network that passes it on to Anthropic with its Claude Code subscription; an API sends anonymized findings to the provider.') }}",
            aiState: "{{ lang._('AI explanations') }}",
            enabledWith: "{{ lang._('enabled with') }}",
            savedProvider: "{{ lang._('Saved provider') }}",
            local: "{{ lang._('Local') }}",
            api: "{{ lang._('API') }}",
            providerLocalNext: "{{ lang._('Next: storage, runtime, model, limits and test on this firewall.') }}",
            providerRemoteNext: "{{ lang._('Nothing to install on this firewall: the next step collects the connection details and enables the AI.') }}",
            goToFinish: "{{ lang._('Go to Finish') }}",
            /* step 3: storage */
            storageHelp: "{{ lang._('Models are stored below /var/db/ai (a ZFS dataset on ZFS systems). The directory comes from the Settings (Models directory).') }}",
            modelsDir: "{{ lang._('Models directory') }}",
            storageState: "{{ lang._('State') }}",
            exists: "{{ lang._('exists') }}",
            missing: "{{ lang._('does not exist yet') }}",
            notWritable: "{{ lang._('exists but is not writable') }}",
            dataset: "{{ lang._('Dataset / filesystem') }}",
            freeSpace: "{{ lang._('Free space') }}",
            notLocal: "{{ lang._('not a local filesystem') }}",
            storageReady: "{{ lang._('The storage is ready; nothing to do here.') }}",
            storagePlanHelp: "{{ lang._('Apply creates the dataset (if the root is ZFS) and the directory. Simulate shows the exact commands first.') }}",
            storageDirHint: "{{ lang._('To use another directory change the Models directory in the Settings first, then come back here.') }}",
            prepareStorage: "{{ lang._('Prepare storage') }}",
            /* step 4: runtime */
            runtimeHelp: "{{ lang._('Ollama runs in an isolated FreeBSD jail below /var/db/ai/jail, without network access, listening on 127.0.0.1:11434 only. The package database of OPNsense is not touched.') }}",
