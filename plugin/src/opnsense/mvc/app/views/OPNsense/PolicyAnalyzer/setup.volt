            openSettings: "{{ lang._('Open Settings') }}",
            goTo: "{{ lang._('Go to %s') }}",
            runAnalysis: "{{ lang._('Run analysis now') }}",
            seeAllModels: "{{ lang._('See all models') }}",
            closedWithJob: "{{ lang._('The assistant was closed, the background job keeps running (closing does not cancel it). Its progress and Cancel button are at the top of the Action history.') }}",
            openHistory: "{{ lang._('Open the action history') }}",
            /* navigation */
            currentState: "{{ lang._('Current state (detected now)') }}",
            loading: "{{ lang._('Reading the current state...') }}",
            back: "{{ lang._('Back') }}",
            skip: "{{ lang._('Skip') }}",
            undo: "{{ lang._('Undo') }}",
            simulate: "{{ lang._('Simulate') }}",
            apply: "{{ lang._('Apply') }}",
            next: "{{ lang._('Next') }}",
            close: "{{ lang._('Close') }}",
