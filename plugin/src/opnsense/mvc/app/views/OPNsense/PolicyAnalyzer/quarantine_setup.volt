{#
 # Quarantine setup assistant: strings of PAQSetup (js/policyanalyzer/quarantine-setup.js), included by index.volt.
 # The assistant is a modal over the Quarantine tab (Install / Setup / Repair / Remove buttons, #qsetup[-N]); every
 # step is its own change action (scripts/policyanalyzer/quarantine/steps.py), see WIZARD.md "Quarantine wizard".
 #}
<script>
    'use strict';

    $(document).ready(function () {
        PAQSetup.setStrings({
            title: "{{ lang._('Quarantine setup') }}",
            stepsLabel: "{{ lang._('Steps') }}",
            helpTitle: "{{ lang._('What does the quarantine setup do?') }}",
            intro: "{{ lang._('Installs the automatic quarantine (rule \'Max Cyber IA\') step by step. Every step shows the state detected now; Simulate shows exactly what would change, Apply asks for confirmation, and Undo reverts that step alone (its entry in the action history).') }}",
            currentState: "{{ lang._('Current state (detected now)') }}",
            loading: "{{ lang._('Reading the current state...') }}",
            back: "{{ lang._('Back') }}",
            skip: "{{ lang._('Skip') }}",
            undo: "{{ lang._('Undo') }}",
            simulate: "{{ lang._('Simulate') }}",
            apply: "{{ lang._('Apply') }}",
            next: "{{ lang._('Next') }}",
            close: "{{ lang._('Close') }}",
            cancel: "{{ lang._('Cancel') }}",
            error: "{{ lang._('Error') }}",
            stepOf: "{{ lang._('Step %n of %t') }}",
            goTo: "{{ lang._('Go to %s') }}",
            step_check: "{{ lang._('Check') }}",
            step_ledger: "{{ lang._('Ledger') }}",
            step_aliases: "{{ lang._('Aliases') }}",
            step_rule: "{{ lang._('Rule') }}",
            step_scenarios: "{{ lang._('Scenarios') }}",
            step_schedule: "{{ lang._('Schedule') }}",
            step_activate: "{{ lang._('Activate') }}",
            step_finish: "{{ lang._('Finish') }}",
            yes: "{{ lang._('yes') }}",
            no: "{{ lang._('no') }}",
            none: "{{ lang._('none') }}",
            present: "{{ lang._('present') }}",
            missing: "{{ lang._('missing') }}",
            enabled: "{{ lang._('enabled') }}",
            disabled: "{{ lang._('disabled') }}",
            running: "{{ lang._('running') }}",
            notRunning: "{{ lang._('not running') }}",
            readOnlyStep: "{{ lang._('This step only reads the system; nothing is changed.') }}",
            probeFailed: "{{ lang._('The state could not be read (see the system log).') }}",
            undoHelp: "{{ lang._('Changes made by this step, newest first. Revert first shows a simulation of what will be undone.') }}",
            undoEmpty: "{{ lang._('This step has not changed anything yet.') }}",
            reverted: "{{ lang._('reverted') }}",
            revert: "{{ lang._('Revert') }}",
            undoFull: "{{ lang._('Open the full action history') }}",
            plainRevert: "{{ lang._('Undo of this step: the button Undo of the assistant, or Revert in the action history.') }}",
            checkHelp: "{{ lang._('What the quarantine would see on this firewall right now: the WAN interfaces, how many external sources the filter blocks there, the sources of events and the addresses that are never quarantined.') }}",
            wanNone: "{{ lang._('No WAN interface found.') }}",
            blocked5: "{{ lang._('%b blocked from %s sources in 5 min') }}",
            blocked60: "{{ lang._('1 h: %b / %s') }}",
            estimate: "{{ lang._('Would enter (estimate)') }}",
            estimateText: "{{ lang._('≈ %a per 5 min · %b per hour') }}",
            filterLog: "{{ lang._('Filter log') }}",
            logCovers: "{{ lang._('the last %m min were read') }}",
            logMissing: "{{ lang._('missing') }}",
            suricata: "{{ lang._('Suricata') }}",
            eve: "{{ lang._('eve.json') }}",
            suricataOff: "{{ lang._('scenario disabled in the settings') }}",
            limit: "{{ lang._('Limit') }}",
            limitText: "{{ lang._('%m active entries (now %n)') }}",
            guards: "{{ lang._('Guards: never quarantined') }}",
            seeAll: "{{ lang._('See all') }}",
            alwaysProtected: "{{ lang._('always') }}",
            g_firewall: "{{ lang._('this firewall') }}",
            g_gateway: "{{ lang._('gateways') }}",
            g_dns: "{{ lang._('DNS servers') }}",
            g_ntp: "{{ lang._('NTP servers') }}",
            g_wireguard_peer: "{{ lang._('WireGuard peers') }}",
            g_tailscale_peer: "{{ lang._('Tailscale peers') }}",
            g_wireguard_allowed: "{{ lang._('WireGuard clients (24 h)') }}",
            g_never_block: "{{ lang._('pa_never_block') }}",
            g_admin_session: "{{ lang._('admin sessions') }}",
            ledgerHelp: "{{ lang._('The ledger is the SQLite database of the quarantine: every offense, entry and exit, kept forever, plus the settings of the scenarios. Reading starts at the current end of the logs.') }}",
            ledger: "{{ lang._('Ledger') }}",
            ledgerSize: "{{ lang._('Size') }}",
            ledgerHistory: "{{ lang._('History') }}",
            historyText: "{{ lang._('%e entries, %o offenses') }}",
            since: "{{ lang._('since') }}",
            createdAt: "{{ lang._('Created') }}",
            detachedTitle: "{{ lang._('Disconnected ledgers (kept)') }}",
            ledgerReady: "{{ lang._('The ledger exists; nothing to create.') }}",
            connectAgain: "{{ lang._('Connect again') }}",
            disconnect: "{{ lang._('Disconnect (keep everything)') }}",
            deleteLedger: "{{ lang._('Delete the ledger...') }}",
            ledgerUndoHelp: "{{ lang._('Undo removes an empty ledger. A ledger with history is only disconnected (renamed and kept); deleting it is a separate, explicit option with a double confirmation.') }}",
            ledgerCreate: "{{ lang._('Create the ledger') }}",
            ledgerApply: "{{ lang._('Apply creates %p (SQLite, WAL) and remembers the current end of the filter log and of eve.json: what happened before is not counted.') }}",
            aliasesHelp: "{{ lang._('pa_quarantine (External) holds the quarantined addresses as a pf table filled at run time; pa_never_block (Network) lists what you never want quarantined.') }}",
            neverBlockTitle: "{{ lang._('pa_never_block') }}",
            neverEmpty: "{{ lang._('empty') }}",
            neverAdd: "{{ lang._('Add') }}",
            neverRemove: "{{ lang._('Remove %s') }}",
            neverPlaceholder: "{{ lang._('203.0.113.7 or 203.0.113.0/28') }}",
            neverInvalid: "{{ lang._('Enter an address or a network (CIDR).') }}",
            neverNeedsAlias: "{{ lang._('The list can be edited once the aliases exist (Apply).') }}",
            entries: "{{ lang._('entries') }}",
            createAliases: "{{ lang._('Create aliases') }}",
            removeAliases: "{{ lang._('Remove the aliases') }}",
            ruleHelp: "{{ lang._('The rule \'Max Cyber IA\' blocks (quick, logged, IPv4+IPv6) inbound traffic from pa_quarantine on the WAN interfaces, before every other rule of its group.') }}",
            ruleState: "{{ lang._('Rule') }}",
            sequence: "{{ lang._('Sequence') }}",
            interfaces: "{{ lang._('Interfaces') }}",
            floating: "{{ lang._('floating') }}",
            createAs: "{{ lang._('Create the rule') }}",
            createOn: "{{ lang._('enabled now') }}",
            createOff: "{{ lang._('disabled (turned on in step 7, recommended)') }}",
            position: "{{ lang._('Position') }}",
            positionText: "{{ lang._('sequence %s, %t, among %n enabled rules') }}",
            precedes: "{{ lang._('Evaluated before') }}",
            wanPass: "{{ lang._('WAN pass rules after it') }}",
            removeRule: "{{ lang._('Remove the rule') }}",
            createRule: "{{ lang._('Create the rule') }}",
            scenariosHelp: "{{ lang._('When an external address enters the quarantine. Fixed by design: the base trigger (1 or more blocked inbound connections in the 5-minute window) and the ladder of durations; the rest is adjustable.') }}",
            fixedBase: "{{ lang._('Base: ≥ 1 blocked connection in the window') }}",
            ladder: "{{ lang._('Ladder') }}",
            custom: "{{ lang._('custom') }}",
            dflt: "{{ lang._('default') }}",
            set_reset_days: "{{ lang._('Reset after (days without offenses)') }}",
            set_scan_ports: "{{ lang._('Port scan: distinct ports') }}",
            set_scan_window: "{{ lang._('Port scan: window (s)') }}",
            set_bait_ports: "{{ lang._('Bait ports (separated by +)') }}",
            set_suricata: "{{ lang._('Use Suricata alerts') }}",
            set_suricata_severity: "{{ lang._('Suricata severity up to') }}",
            set_max_active: "{{ lang._('Limit of active entries') }}",
            set_syn_only: "{{ lang._('TCP: only connection attempts (SYN)') }}",
            preview: "{{ lang._('Preview: with the logs of the last 5 min, %n address(es) would enter') }}",
            previewNone: "{{ lang._('nobody') }}",
            previewPartial: "{{ lang._('the log covers only %s s') }}",
            previewRefresh: "{{ lang._('Refresh preview') }}",
            previewOld: "{{ lang._('already in quarantine') }}",
            level: "{{ lang._('level') }}",
            defaults: "{{ lang._('Defaults') }}",
            invalid: "{{ lang._('Check the highlighted values.') }}",
            needsLedger: "{{ lang._('The scenarios are stored in the ledger: create it first (step 2).') }}",
            noChange: "{{ lang._('No value changed yet: edit a field to simulate.') }}",
            scheduleHelp: "{{ lang._('Runs the quarantine every 5 minutes (System: Settings: Cron) and rebuilds the pf table from the ledger after a reboot (boot hook).') }}",
            cron: "{{ lang._('Cron job') }}",
            every: "{{ lang._('every') }}",
            nextRun: "{{ lang._('Next run') }}",
            bootHook: "{{ lang._('Boot hook') }}",
            removeSchedule: "{{ lang._('Remove schedule') }}",
            activateHelp: "{{ lang._('Turns the rule on (if it was created disabled), marks the quarantine as running and runs it once now. Undo pauses it: the rule is disabled and the ledger keeps recording.') }}",
            paused: "{{ lang._('Paused') }}",
            lastRun: "{{ lang._('Last run') }}",
            never: "{{ lang._('never') }}",
            runText: "{{ lang._('%o entered, %s sources, %g protected, %d ms') }}",
            firstRun: "{{ lang._('Result of the first run') }}",
            actEnable: "{{ lang._('Enable the rule Max Cyber IA and reload the rules (it is disabled now).') }}",
            actResume: "{{ lang._('Mark the quarantine as running (it is paused now).') }}",
            actRun: "{{ lang._('Run the quarantine once now; Simulate shows who would enter (read from the logs since the ledger was created).') }}",
            entered: "{{ lang._('Entered') }}",
            byReason: "{{ lang._('by reason') }}",
            pause: "{{ lang._('Pause') }}",
            resume: "{{ lang._('Resume') }}",
            finishHelp: "{{ lang._('The quarantine is ready when every step is done. Each step can be undone alone; Remove all goes through the inverse steps one by one and keeps the ledger unless you choose otherwise.') }}",
            summary: "{{ lang._('Summary') }}",
            done: "{{ lang._('done') }}",
            notDone: "{{ lang._('not done') }}",
            openTab: "{{ lang._('Open the Quarantine tab') }}",
            removeAll: "{{ lang._('Remove all (step by step)') }}",
            removeAllTitle: "{{ lang._('Remove all') }}",
            removeAllHelp: "{{ lang._('The inverse steps run one by one, each with its own simulation and confirmation and its own entry in the action history (each can be undone).') }}",
            rmSchedule: "{{ lang._('Schedule (6): remove the cron job and the boot hook') }}",
            rmRule: "{{ lang._('Rule (4): end the active quarantines, remove the rule') }}",
            rmAliases: "{{ lang._('Aliases (3): remove pa_quarantine and pa_never_block (its entries are saved for Undo)') }}",
            rmLedger: "{{ lang._('Ledger (2)') }}",
            keepLedger: "{{ lang._('keep it (default)') }}",
            detachLedger: "{{ lang._('disconnect it (renamed, kept)') }}",
            purgeLedger: "{{ lang._('delete it with its history (double confirmation, irreversible)') }}",
            start: "{{ lang._('Start') }}",
            nothingToRemove: "{{ lang._('Nothing to remove.') }}",
            installed: "{{ lang._('Installed') }}",
            notInstalled: "{{ lang._('Not installed') }}"
        });
    });
</script>
